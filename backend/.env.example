# Copy to .env and fill in. One LLM key is required: Anthropic is preferred if
# both are set; Gemini (aistudio.google.com) is the free-tier alternative.
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
DATABASE_URL=sqlite:///./orbit.db

# Gmail OAuth (Google Cloud Console -> OAuth client, type "Web application")
# Redirect URI must be: http://localhost:8000/api/email/oauth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/email/oauth/callback

# Job sources (all optional; Remotive needs no key)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=sg

# Scheduler (24h clock, server local time)
DAILY_EMAIL_SCAN_HOUR=8
DAILY_JOB_SCAN_HOUR=7

FRONTEND_ORIGIN=http://localhost:5173
